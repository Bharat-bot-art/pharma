<%
  const page = 'faq';
  const groups = {};
  (faqs || []).forEach((f) => {
    const k = f.category || 'general';
    groups[k] = groups[k] || [];
    groups[k].push(f);
  });
%>
<%- include('../partials/head', { page, title }) %>
<div class="page-hero">
  <div class="container">
    <h1>Frequently Asked Questions</h1>
    <p>Answers to common questions about orders, delivery, prescriptions and more.</p>
  </div>
</div>
<div class="container" style="padding:48px 0 64px;max-width:820px">
  <div class="crumbs">
    <a href="/">Home</a><span class="sep">/</span><span class="cur">FAQs</span>
  </div>
  <% if (Object.keys(groups).length === 0) { %>
    <div class="empty-state card">
      <div class="art"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" style="color:var(--ink-300);width:64px;height:64px"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M12 11v5"/></svg></div>
      <h3 style="font-size:18px">No FAQs published yet</h3>
      <p class="text-muted">Our support team is happy to help.</p>
      <a class="btn btn-primary" href="/contact">Contact Us</a>
    </div>
  <% } else { %>
    <% Object.entries(groups).forEach(([cat, items]) => { %>
      <h2 style="font-size:18px;margin:28px 0 14px;text-transform:capitalize"><%= cat.replace(/-/g, ' ') %></h2>
      <div class="card" style="padding:0;overflow:hidden">
        <% items.forEach((f, i) => { %>
          <details class="faq-item" <%= i === 0 ? 'open' : '' %>>
            <summary><%= f.question %><span class="faq-caret"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></span></summary>
            <div class="faq-answer"><p><%= f.answer %></p></div>
          </details>
        <% }) %>
      </div>
    <% }) %>
    <div class="card" style="padding:24px;margin-top:32px;text-align:center">
      <h3 style="font-size:17px;margin-bottom:4px">Still have questions?</h3>
      <p class="text-sm text-muted" style="margin-bottom:16px">Our pharmacist support team is here to help you.</p>
      <a class="btn btn-primary" href="/contact">Get in Touch</a>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
