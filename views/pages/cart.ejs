<%
  const page = 'cart';
%>
<%- include('../partials/head', { page, title }) %>
<div class="page-hero">
  <div class="container"><h1>Your Cart</h1><p>Review your items before checkout.</p></div>
</div>
<div class="container" style="padding:40px 0 64px">
  <div class="cart-layout">
    <div data-cart-page-items>
      <div class="skeleton" style="height:120px;margin-bottom:16px"></div>
      <div class="skeleton" style="height:120px;margin-bottom:16px"></div>
    </div>
    <aside class="order-summary" data-cart-summary style="display:none">
      <h3 style="font-size:17px;margin-bottom:14px">Order Summary</h3>
      <div class="sum-row"><span>Items</span><span data-summary-count>0</span></div>
      <div class="sum-row"><span>Subtotal</span><span data-summary-subtotal>₹0</span></div>
      <div class="sum-row"><span>Delivery</span><span data-summary-shipping>₹0</span></div>
      <div class="sum-row"><span>GST</span><span>Included</span></div>
      <div class="sum-row total"><span>Total</span><span data-summary-total>₹0</span></div>
      <div class="row" style="margin-top:14px;font-size:12.5px;color:var(--success);font-weight:600" data-free-ship-hint></div>
      <a class="btn btn-primary btn-block btn-lg" href="/checkout" style="margin-top:16px">Proceed to Checkout</a>
      <a class="btn btn-ghost btn-block" href="/shop">Continue Shopping</a>
    </aside>
  </div>
  <div class="empty-state card" data-cart-empty style="display:none">
    <div class="art"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" style="color:var(--ink-300);width:64px;height:64px"><path d="M6 7h12l1 13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1L6 7Z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg></div>
    <h3 style="font-size:18px">Your cart is empty</h3>
    <p class="text-muted">Browse our medicines and wellness range to get started.</p>
    <a class="btn btn-primary" href="/shop">Start Shopping</a>
  </div>
</div>
<%- include('../partials/footer') %>
<script src="/js/cart-page.js" defer></script>
