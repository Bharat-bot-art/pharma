<%
  const page = 'wishlist';
%>
<%- include('../partials/head', { page, title }) %>
<div class="container" style="padding:40px 0 64px">
  <div class="acc-head">
    <div>
      <h1 style="font-size:28px;margin-bottom:4px">My Wishlist</h1>
      <p class="text-muted" style="margin:0">Medicines and products you've saved for later.</p>
    </div>
    <a class="btn btn-outline" href="/shop">Browse Shop</a>
  </div>
  <div class="account-layout">
    <%- include('partials/nav', { page }) %>
    <div data-wishlist-grid>
      <div class="product-grid-4">
        <% for (let i = 0; i < 4; i++) { %>
          <div class="card" style="overflow:hidden">
            <div class="skeleton" style="aspect-ratio:1/1;border-radius:0"></div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
<script src="/js/wishlist.js" defer></script>
