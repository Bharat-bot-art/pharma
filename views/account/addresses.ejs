<%
  const page = 'addresses';
%>
<%- include('../partials/head', { page, title }) %>
<div class="container" style="padding:40px 0 64px">
  <div class="acc-head">
    <div>
      <h1 style="font-size:28px;margin-bottom:4px">Saved Addresses</h1>
      <p class="text-muted" style="margin:0">Manage delivery addresses for faster checkout.</p>
    </div>
    <button class="btn btn-primary" data-open-address-modal>+ Add Address</button>
  </div>
  <div class="account-layout">
    <%- include('partials/nav', { page }) %>
    <div data-addresses-list>
      <div class="skeleton" style="height:120px;margin-bottom:16px"></div>
      <div class="skeleton" style="height:120px;margin-bottom:16px"></div>
    </div>
  </div>
</div>

<div class="modal-backdrop" data-address-modal style="display:none;animation:none;opacity:1">
  <div class="modal" style="max-width:560px">
    <div class="row" style="justify-content:space-between;margin-bottom:20px">
      <h2 style="margin:0;font-size:19px" data-address-modal-title>Add Address</h2>
      <button class="icon-btn" data-close-address-modal><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div id="addr-error-slot"></div>
    <form data-address-form novalidate>
      <input type="hidden" name="id">
      <div class="form-grid-2">
        <div class="field"><label class="label">Label</label><input class="input" name="label" placeholder="Home / Office"></div>
        <div class="field"><label class="label">Mobile Number</label><input class="input" name="mobile" inputmode="numeric" maxlength="10" required></div>
      </div>
      <div class="form-grid-2">
        <div class="field"><label class="label">Full Name</label><input class="input" name="name" required></div>
        <div class="field"><label class="label">Pincode</label><input class="input" name="pincode" inputmode="numeric" maxlength="6" required></div>
      </div>
      <div class="field"><label class="label">Address</label><textarea class="input" name="address" rows="2" placeholder="House no, street, area, landmark" required></textarea></div>
      <div class="form-grid-2">
        <div class="field"><label class="label">City</label><input class="input" name="city" required></div>
        <div class="field"><label class="label">State</label><input class="input" name="state" required></div>
      </div>
      <label class="row" style="gap:8px;font-size:14px;cursor:pointer;margin-bottom:20px"><input type="checkbox" name="isDefault" style="accent-color:var(--green-600)"> Set as default address</label>
      <div class="row" style="justify-content:flex-end;gap:10px">
        <button class="btn btn-ghost" type="button" data-close-address-modal>Cancel</button>
        <button class="btn btn-primary" type="submit" data-save-address><span>Save Address</span></button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
<script src="/js/addresses.js" defer></script>
