<%
  const page = 'admin';
  const adminSection = 'banners';
%>
<%- include('../partials/head', { page, title }) %>
<div class="container" style="padding:40px 0 64px">
  <div class="acc-head">
    <div>
      <h1 style="font-size:28px;margin-bottom:4px">Banners</h1>
      <p class="text-muted" style="margin:0">Homepage promotional banners.</p>
    </div>
    <button class="btn btn-primary" data-open-banner-modal>+ Add Banner</button>
  </div>
  <div class="admin-layout">
    <%- include('partials/nav', { adminSection }) %>
    <div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Title</th><th>Subtitle</th><th>CTA</th><th>Sort</th><th>Status</th><th style="width:120px">Actions</th></tr></thead>
          <tbody data-banners-body>
            <tr><td colspan="6"><div class="skeleton" style="height:50px"></div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="modal-backdrop" data-banner-modal style="display:none;animation:none;opacity:1">
  <div class="modal" style="max-width:520px">
    <div class="row" style="justify-content:space-between;margin-bottom:20px">
      <h2 style="margin:0;font-size:19px" data-banner-modal-title>Add Banner</h2>
      <button class="icon-btn" data-close-banner-modal><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div id="banner-error-slot"></div>
    <form data-banner-form novalidate>
      <input type="hidden" name="id">
      <div class="field"><label class="label">Title</label><input class="input" name="title" required></div>
      <div class="field"><label class="label">Subtitle</label><input class="input" name="subtitle"></div>
      <div class="form-grid-2">
        <div class="field"><label class="label">CTA Label</label><input class="input" name="ctaLabel" placeholder="Shop Now"></div>
        <div class="field"><label class="label">CTA Link</label><input class="input" name="ctaLink" placeholder="/shop"></div>
        <div class="field"><label class="label">Sort Order</label><input class="input" name="sortOrder" type="number" value="0"></div>
        <div class="field"><label class="label">Color (hex)</label><input class="input" name="imageHue" type="color" value="#0e7a5f" style="height:44px;padding:6px"></div>
      </div>
      <div class="field">
        <label class="label">Banner Image</label>
        <div class="row" style="gap:10px;align-items:center;flex-wrap:wrap">
          <input type="file" class="input" name="bannerImage" accept="image/*" style="flex:1;min-width:200px">
          <div id="banner-image-preview" style="display:none;width:80px;height:40px;border-radius:8px;overflow:hidden;border:1px solid var(--ink-200)"><img src="" alt="Preview" style="width:100%;height:100%;object-fit:cover"></div>
          <button type="button" class="btn btn-outline btn-sm" id="remove-banner-image" style="display:none">Remove</button>
        </div>
        <p class="text-xs text-muted" style="margin:4px 0 0">Upload JPG/PNG/WebP (max 5MB). Falls back to color if not provided.</p>
      </div>
      <label class="row" style="gap:8px;font-size:14px;cursor:pointer;margin-bottom:20px"><input type="checkbox" name="isActive" checked style="accent-color:var(--green-600)"> Active</label>
      <div class="row" style="justify-content:flex-end;gap:10px">
        <button class="btn btn-ghost" type="button" data-close-banner-modal>Cancel</button>
        <button class="btn btn-primary" type="submit" data-save-banner><span>Save Banner</span></button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
<script src="/js/admin.js" defer></script>
