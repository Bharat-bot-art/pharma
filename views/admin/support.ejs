<%
  const page = 'admin';
  const adminSection = 'support';
%>
<%- include('../partials/head', { page, title }) %>
<div class="container" style="padding:40px 0 64px">
  <div class="acc-head">
    <div>
      <h1 style="font-size:28px;margin-bottom:4px">Support Messages</h1>
      <p class="text-muted" style="margin:0">Messages from the contact form.</p>
    </div>
  </div>
  <div class="admin-layout">
    <%- include('partials/nav', { adminSection }) %>
    <div>
      <div class="toolbar">
        <span class="result-count" data-support-count>– messages</span>
        <div class="row">
          <label class="text-sm" style="color:var(--ink-500);font-weight:600">Filter</label>
          <select class="input" data-support-filter style="width:auto;padding:9px 36px 9px 14px">
            <option value="all">All</option>
            <option value="new">New</option>
            <option value="replied">Replied</option>
            <option value="closed">Closed</option>
          </select>
        </div>
      </div>
      <div data-support-list>
        <div class="skeleton" style="height:90px;margin-bottom:12px"></div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
<script src="/js/admin.js" defer></script>
