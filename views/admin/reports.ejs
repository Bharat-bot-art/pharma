<%
  const page = 'admin';
  const adminSection = 'reports';
%>
<%- include('../partials/head', { page, title }) %>
<div class="container" style="padding:40px 0 64px">
  <div class="acc-head">
    <div>
      <h1 style="font-size:28px;margin-bottom:4px">Sales Reports</h1>
      <p class="text-muted" style="margin:0">Revenue and order analytics.</p>
    </div>
    <div class="row" style="gap:8px">
      <label class="text-sm" style="color:var(--ink-500);font-weight:600">Range</label>
      <select class="input" data-report-range style="width:auto;padding:9px 36px 9px 14px">
        <option value="7">Last 7 days</option>
        <option value="14" selected>Last 14 days</option>
        <option value="30">Last 30 days</option>
        <option value="90">Last 90 days</option>
      </select>
    </div>
  </div>
  <div class="admin-layout">
    <%- include('partials/nav', { adminSection }) %>
    <div data-reports-root>
      <div class="stat-grid" data-report-totals>
        <div class="stat-card"><div class="ico" style="background:var(--green-50);color:var(--green-600)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 6 9 17l-5-5"/></svg></div><div class="num" data-t="revenue">–</div><div class="lbl">Revenue</div></div>
        <div class="stat-card"><div class="ico" style="background:var(--blue-50);color:var(--blue-600)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 3 7.5v9L12 21l9-4.5v-9L12 3Z"/><path d="M3 7.5l9 4.5 9-4.5"/><path d="M12 12v9"/></svg></div><div class="num" data-t="orders">–</div><div class="lbl">Orders</div></div>
        <div class="stat-card"><div class="ico" style="background:var(--warning-bg);color:var(--warning)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h4l1.5 5-2.2 1.6a14 14 0 0 0 5 5L16 12.5l5 1.5v4a2 2 0 0 1-2 2A17 17 0 0 1 4 5a2 2 0 0 1 2-2Z"/></svg></div><div class="num" data-t="codDue">–</div><div class="lbl">COD Due</div></div>
        <div class="stat-card"><div class="ico" style="background:var(--danger-bg);color:var(--danger)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 2 20h20L12 3Z"/></svg></div><div class="num" data-t="cancelled">–</div><div class="lbl">Cancelled</div></div>
      </div>
      <div style="display:grid;gap:20px;margin-top:20px">
        <div class="card" style="padding:24px">
          <h2 style="font-size:16px;margin-bottom:14px">Daily sales</h2>
          <div class="table-wrap">
            <table class="data-table">
              <thead><tr><th>Date</th><th>Orders</th><th>Revenue</th></tr></thead>
              <tbody data-daily-body><tr><td colspan="3"><div class="skeleton" style="height:40px"></div></td></tr></tbody>
            </table>
          </div>
        </div>
        <div class="card" style="padding:24px">
          <h2 style="font-size:16px;margin-bottom:14px">Top products</h2>
          <div class="table-wrap">
            <table class="data-table">
              <thead><tr><th>Product</th><th>Qty sold</th><th>Revenue</th></tr></thead>
              <tbody data-top-body><tr><td colspan="3"><div class="skeleton" style="height:40px"></div></td></tr></tbody>
            </table>
          </div>
        </div>
        <div class="card" style="padding:24px">
          <h2 style="font-size:16px;margin-bottom:14px">Payment methods</h2>
          <div class="table-wrap">
            <table class="data-table">
              <thead><tr><th>Method</th><th>Orders</th><th>Revenue</th></tr></thead>
              <tbody data-payments-body></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
<script src="/js/admin.js" defer></script>
