<%
  const page = 'admin';
  const adminSection = 'coupons';
%>
<%- include('../partials/head', { page, title }) %>
<div class="container" style="padding:40px 0 64px">
  <div class="acc-head">
    <div>
      <h1 style="font-size:28px;margin-bottom:4px">Coupons</h1>
      <p class="text-muted" style="margin:0">Create discount codes to boost sales.</p>
    </div>
    <button class="btn btn-primary" data-open-coupon-modal>+ Add Coupon</button>
  </div>
  <div class="admin-layout">
    <%- include('partials/nav', { adminSection }) %>
    <div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Code</th><th>Type</th><th>Value</th><th>Min. Subtotal</th><th>Used</th><th>Expires</th><th>Status</th><th style="width:120px">Actions</th></tr></thead>
          <tbody data-coupons-body>
            <tr><td colspan="8"><div class="skeleton" style="height:50px"></div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="modal-backdrop" data-coupon-modal style="display:none;animation:none;opacity:1">
  <div class="modal" style="max-width:520px">
    <div class="row" style="justify-content:space-between;margin-bottom:20px">
      <h2 style="margin:0;font-size:19px" data-coupon-modal-title>Add Coupon</h2>
      <button class="icon-btn" data-close-coupon-modal><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div id="coupon-error-slot"></div>
    <form data-coupon-form novalidate>
      <input type="hidden" name="id">
      <div class="form-grid-2">
        <div class="field"><label class="label">Code</label><input class="input" name="code" placeholder="SAVE10" required></div>
        <div class="field"><label class="label">Type</label><select class="input" name="type"><option value="percent">Percent (%)</option><option value="fixed">Fixed (₹)</option></select></div>
        <div class="field"><label class="label">Value</label><input class="input" name="value" type="number" min="0" step="0.5" required></div>
        <div class="field"><label class="label">Min. Subtotal (₹)</label><input class="input" name="minSubtotal" type="number" min="0" step="0.5"></div>
        <div class="field"><label class="label">Max Discount (₹)</label><input class="input" name="maxDiscount" type="number" min="0" step="0.5"></div>
        <div class="field"><label class="label">Usage Limit</label><input class="input" name="usageLimit" type="number" min="0"></div>
        <div class="field"><label class="label">Expires At</label><input class="input" name="expiresAt" type="datetime-local"></div>
      </div>
      <label class="row" style="gap:8px;font-size:14px;cursor:pointer;margin-bottom:20px"><input type="checkbox" name="isActive" checked style="accent-color:var(--green-600)"> Active</label>
      <div class="row" style="justify-content:flex-end;gap:10px">
        <button class="btn btn-ghost" type="button" data-close-coupon-modal>Cancel</button>
        <button class="btn btn-primary" type="submit" data-save-coupon><span>Save Coupon</span></button>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
<script src="/js/admin.js" defer></script>
