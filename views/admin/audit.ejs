<%
  const page = 'admin';
  const adminSection = 'audit';
%>
<%- include('../partials/head', { page, title }) %>

<div class="container" style="padding:40px 0 64px">
  <div class="acc-head">
    <div>
      <h1 style="font-size:28px;margin-bottom:4px">Audit Logs</h1>
      <p class="text-muted" style="margin:0">Track all admin activities and changes.</p>
    </div>
  </div>

  <div class="admin-layout">
    <%- include('partials/nav', { adminSection }) %>
    <div>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Admin</th>
              <th>Action</th>
              <th>Entity</th>
              <th>Details</th>
              <th>IP Address</th>
            </tr>
          </thead>
          <tbody data-audit-body>
            <tr><td colspan="6"><div class="skeleton" style="height:50px"></div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/js/admin.js" defer></script>
