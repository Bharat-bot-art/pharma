<%
  const page = 'admin';
  const adminSection = 'consultations';
%>
<%- include('../partials/head', { page, title }) %>
<div class="container" style="padding:40px 0 64px">
  <div class="acc-head">
    <div>
      <h1 style="font-size:28px;margin-bottom:4px">Consultation Requests</h1>
      <p class="text-muted" style="margin:0">Health consultation requests from customers.</p>
    </div>
  </div>
  <div class="admin-layout">
    <%- include('partials/nav', { adminSection }) %>
    <div>
      <div class="toolbar">
        <span class="result-count" data-consult-count>– requests</span>
        <div class="row">
          <label class="text-sm" style="color:var(--ink-500);font-weight:600">Filter</label>
          <select class="input" data-consult-filter style="width:auto;padding:9px 36px 9px 14px">
            <option value="all">All</option>
            <option value="new">New</option>
            <option value="contacted">Contacted</option>
            <option value="resolved">Resolved</option>
          </select>
        </div>
      </div>
      <div data-consult-list>
        <div class="skeleton" style="height:90px;margin-bottom:12px"></div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
<script src="/js/admin.js" defer></script>
