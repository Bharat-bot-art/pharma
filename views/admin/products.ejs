<%
  const page = 'admin';
  const adminSection = 'products';
%>
<%- include('../partials/head', { page, title }) %>
<div class="container" style="padding:40px 0 64px">
  <div class="acc-head">
    <div>
      <h1 style="font-size:28px;margin-bottom:4px">Products</h1>
      <p class="text-muted" style="margin:0">Manage your catalogue.</p>
    </div>
    <button class="btn btn-primary" data-open-product-modal>+ Add Product</button>
  </div>
  <div class="admin-layout">
    <%- include('partials/nav', { adminSection }) %>
    <div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Product</th><th>Category</th><th>Price</th><th>MRP</th><th>Stock</th><th>Rating</th><th style="width:90px">Actions</th></tr></thead>
          <tbody data-products-body>
            <tr><td colspan="7"><div class="skeleton" style="height:50px"></div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="modal-backdrop" data-product-modal style="display:none;animation:none;opacity:1">
  <div class="modal" style="max-width:640px">
    <div class="row" style="justify-content:space-between;margin-bottom:20px">
      <h2 style="margin:0;font-size:19px" data-product-modal-title>Add Product</h2>
      <button class="icon-btn" data-close-product-modal><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
    </div>
    <div id="error-slot"></div>
    <form data-product-form novalidate>
      <input type="hidden" name="id">
      <div class="field"><label class="label">Product Name</label><input class="input" name="name" required></div>
      <div class="form-grid-2">
        <div class="field"><label class="label">Category</label><select class="input" name="categoryId" data-cat-select required></select></div>
        <div class="field"><label class="label">Stock</label><input class="input" name="stock" type="number" min="0" required></div>
        <div class="field"><label class="label">MRP (₹)</label><input class="input" name="mrp" type="number" min="0" step="0.5" required></div>
        <div class="field"><label class="label">Selling Price (₹)</label><input class="input" name="price" type="number" min="0" step="0.5" required></div>
        <div class="field"><label class="label">Rating (0–5)</label><input class="input" name="rating" type="number" min="0" max="5" step="0.1"></div>
        <div class="field"><label class="label">Rating Count</label><input class="input" name="ratingCount" type="number" min="0"></div>
        <div class="field"><label class="label">Image Hue (0–359)</label><input class="input" name="imageHue" type="number" min="0" max="359"></div>
        <div class="field"><label class="label">Tags (comma separated)</label><input class="input" name="tags"></div>
      </div>
      <div class="field">
        <label class="label">Product Image</label>
        <div class="row" style="gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:8px">
          <input type="file" class="input" name="productImage" accept="image/*" style="flex:1;min-width:200px">
          <div id="product-image-preview" style="display:none;width:60px;height:60px;border-radius:8px;overflow:hidden;border:1px solid var(--ink-200)"><img src="" alt="Preview" style="width:100%;height:100%;object-fit:cover"></div>
          <button type="button" class="btn btn-outline btn-sm" id="remove-product-image" style="display:none">Remove</button>
        </div>
        <div class="row" style="gap:10px;align-items:center">
          <span class="text-xs text-muted" style="white-space:nowrap">OR Image URL:</span>
          <input type="url" class="input" name="productImageUrl" placeholder="https://example.com/image.jpg" style="flex:1">
        </div>
      </div>
      <div class="field"><label class="label">Short Description</label><input class="input" name="shortDescription"></div>
      <div class="field"><label class="label">Full Description</label><textarea class="input" name="description" rows="3"></textarea></div>
      <div class="row" style="gap:20px;margin-bottom:20px">
        <label class="row" style="gap:8px;font-size:14px;cursor:pointer"><input type="checkbox" name="isPrescription" style="accent-color:var(--green-600)"> Prescription (Rx)</label>
        <label class="row" style="gap:8px;font-size:14px;cursor:pointer"><input type="checkbox" name="featured" style="accent-color:var(--green-600)"> Featured</label>
      </div>
      <div class="row" style="justify-content:flex-end;gap:10px">
        <button class="btn btn-ghost" type="button" data-close-product-modal>Cancel</button>
        <button class="btn btn-primary" type="submit" data-save-product><span>Save Product</span></button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/js/admin.js" defer></script>
