<%
  const page = 'admin';
  const adminSection = 'users';
%>
<%- include('../partials/head', { page, title }) %>
<div class="container" style="padding:40px 0 64px">
  <div class="acc-head">
    <div>
      <h1 style="font-size:28px;margin-bottom:4px">Users</h1>
      <p class="text-muted" style="margin:0">Customer accounts on BIOSYM.</p>
    </div>
  </div>
  <div class="admin-layout">
    <%- include('partials/nav', { adminSection }) %>
    <div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Name</th><th>Email</th><th>Mobile</th><th>Role</th><th>Joined</th><th>Status</th><th>Action</th></tr></thead>
          <tbody data-users-body>
            <tr><td colspan="7"><div class="skeleton" style="height:50px"></div></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
<script src="/js/admin.js" defer></script>
