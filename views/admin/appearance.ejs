<%
  const page = 'admin';
  const adminSection = 'appearance';
%>
<%- include('../partials/head', { page, title }) %>
<div class="container" style="padding:40px 0 64px">
  <div class="acc-head">
    <div>
      <h1 style="font-size:28px;margin-bottom:4px">Site Appearance</h1>
      <p class="text-muted" style="margin:0">Manage the promotional banners and hero images across the store.</p>
    </div>
  </div>
  <div class="admin-layout">
    <%- include('partials/nav', { adminSection }) %>
    <div>
      <div class="co-section" style="max-width: 600px;">
        <h2><span class="step-num"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><path d="M4 22v-7"/></svg></span> Banner Placements</h2>
        <p class="text-muted" style="font-size: 14px; margin-bottom: 24px;">Enter the filename of the image located in the public/img folder (e.g. <code>promo1.png</code>).</p>
        
        <form id="appearance-form">
<hr style="margin: 40px 0; border-top: 1px solid var(--ink-100);">
          <h2 style="font-size: 18px; margin-bottom: 20px;">Theme & Design Settings</h2>

          <div class="field">
            <label class="label">Primary Theme Color</label>
            <input class="input" type="color" name="theme_primary_color" value="<%= settings.theme_primary_color || '#07875d' %>" style="height: 48px; padding: 4px;">
            <p class="text-xs text-muted" style="margin-top:4px">This sets the main brand color used for buttons, links, and accents.</p>
          </div>

          <div class="field" style="margin-top: 12px;">
            <label class="label">Font Family</label>
            <select class="input" name="theme_font_family">
              <option value="'Inter', sans-serif" <%= settings.theme_font_family === "'Inter', sans-serif" ? 'selected' : '' %>>Inter (Modern, Default)</option>
              <option value="'Roboto', sans-serif" <%= settings.theme_font_family === "'Roboto', sans-serif" ? 'selected' : '' %>>Roboto (Clean)</option>
              <option value="'Poppins', sans-serif" <%= settings.theme_font_family === "'Poppins', sans-serif" ? 'selected' : '' %>>Poppins (Friendly)</option>
              <option value="'Playfair Display', serif" <%= settings.theme_font_family === "'Playfair Display', serif" ? 'selected' : '' %>>Playfair Display (Elegant/Serif)</option>
            </select>
          </div>

          <div class="field" style="margin-top: 12px;">
            <label class="label">Button Corner Radius</label>
            <select class="input" name="theme_border_radius">
              <option value="4px" <%= settings.theme_border_radius === '4px' ? 'selected' : '' %>>Slightly Rounded (4px)</option>
              <option value="8px" <%= settings.theme_border_radius === '8px' ? 'selected' : '' %>>Rounded (8px)</option>
              <option value="50px" <%= settings.theme_border_radius === '50px' ? 'selected' : '' %>>Pill Shape (50px)</option>
              <option value="0px" <%= settings.theme_border_radius === '0px' ? 'selected' : '' %>>Square (0px)</option>
            </select>
          </div>

          <div class="row" style="margin-top: 40px; justify-content: flex-end;">
            <button class="btn btn-primary btn-lg" type="submit">Save All Changes</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
document.getElementById('appearance-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = e.target.querySelector('button');
  btn.disabled = true;
  btn.textContent = 'Saving...';
  
  const formData = new FormData(e.target);
  
  try {
    const res = await fetch('/api/admin/settings', {
      method: 'POST',
      body: formData
    });
    
    if (res.ok) {
      alert('Settings saved successfully!');
      window.location.reload();
    } else {
      alert('Failed to save settings');
    }
  } catch (err) {
    alert('An error occurred');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Save Changes';
  }
});
</script>

<%- include('../partials/footer') %>
