<%
  const page = 'admin';
  const adminSection = 'dashboard';
%>
<%- include('../partials/head', { page, title }) %>
<div class="container" style="padding:40px 0 64px">
  <div class="acc-head">
    <div>
      <h1 style="font-size:28px;margin-bottom:4px">Admin Dashboard</h1>
      <p class="text-muted" style="margin:0">Store performance at a glance.</p>
    </div>
    <a class="btn btn-primary" href="/admin/products">+ Add Product</a>
  </div>
  <div class="admin-layout">
    <%- include('partials/nav', { adminSection }) %>
    <div>
      <div class="stat-grid" data-stats>
        <div class="stat-card"><div class="ico" style="background:var(--green-50);color:var(--green-600)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 6 9 17l-5-5"/></svg></div><div class="num" data-s="revenue">–</div><div class="lbl">Revenue</div></div>
        <div class="stat-card"><div class="ico" style="background:var(--blue-50);color:var(--blue-600)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3 3 7.5v9L12 21l9-4.5v-9L12 3Z"/><path d="M3 7.5l9 4.5 9-4.5"/><path d="M12 12v9"/></svg></div><div class="num" data-s="orders">–</div><div class="lbl">Total Orders</div></div>
        <div class="stat-card"><div class="ico" style="background:var(--warning-bg);color:var(--warning)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 7h12l1 13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1L6 7Z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/></svg></div><div class="num" data-s="products">–</div><div class="lbl">Products</div></div>
        <div class="stat-card"><div class="ico" style="background:var(--danger-bg);color:var(--danger)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/></svg></div><div class="num" data-s="users">–</div><div class="lbl">Customers</div></div>
      </div>
      <div class="card" style="padding:24px">
        <h2 style="font-size:16px;margin-bottom:4px">Pending orders</h2>
        <p class="text-sm text-muted" style="margin-bottom:16px">Orders awaiting confirmation or packing.</p>
        <div data-pending-orders><div class="skeleton" style="height:60px;margin-bottom:8px"></div></div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
<script src="/js/admin.js" defer></script>
