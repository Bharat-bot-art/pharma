<%
  const page = 'auth';
  const title = 'Set a new password — BIOSYM Pharma';
%>
<%- include('../partials/head', { page, title }) %>

<div class="auth-shell">
  <div class="auth-panel">
    <div class="auth-card">
      <div class="auth-head">
        <img class="auth-mark" src="/favicon.svg" alt="BIOSYM">
        <h1>Create a new password</h1>
        <p>Choose a strong password you haven't used before.</p>
      </div>

      <div id="error-slot"></div>

      <form data-reset-form novalidate>
        <input type="hidden" name="token" value="<%= token %>">
        <div class="field">
          <label class="label" for="new-pw">New Password</label>
          <div class="input-wrap">
            <input class="input" id="new-pw" name="password" type="password" placeholder="Enter a strong password" autocomplete="new-password" required data-caps-lock data-strength>
            <button type="button" class="toggle-pw" data-toggle-pw aria-label="Show password">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <div class="pw-meter" data-pw-meter><span></span><span></span><span></span><span></span></div>
          <div class="pw-label" data-pw-label>Too weak</div>
          <div class="caps-warning" data-caps-warning><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 20h20L12 3Z"/><path d="M12 9v5M12 17.5h.01"/></svg> Caps Lock is on</div>
        </div>
        <div class="field">
          <label class="label" for="new-cpw">Confirm New Password</label>
          <div class="input-wrap">
            <input class="input" id="new-cpw" name="confirmPassword" type="password" placeholder="Re-enter your password" autocomplete="new-password" required>
            <button type="button" class="toggle-pw" data-toggle-pw aria-label="Show password">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <div class="pw-rules" data-pw-rules>
          <span class="pw-rule" data-rule="length"><svg class="no" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"/></svg><span>8+ characters</span></span>
          <span class="pw-rule" data-rule="case"><svg class="no" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"/></svg><span>Upper &amp; lower case</span></span>
          <span class="pw-rule" data-rule="number"><svg class="no" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"/></svg><span>A number</span></span>
          <span class="pw-rule" data-rule="special"><svg class="no" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"/></svg><span>A special character</span></span>
        </div>
        <button class="btn btn-primary btn-lg btn-block" type="submit" data-reset-btn style="margin-top:6px">
          <span>Update Password</span>
        </button>
      </form>

      <div class="auth-alt" style="margin-top:18px"><a class="link" href="/login">← Back to sign in</a></div>
    </div>
  </div>

  <div class="auth-side">
    <svg class="molecule" viewBox="0 0 200 200" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1.6">
      <circle cx="100" cy="40" r="14"/><circle cx="40" cy="130" r="14"/><circle cx="160" cy="130" r="14"/><circle cx="100" cy="170" r="14"/>
      <line x1="100" y1="54" x2="48" y2="118"/><line x1="100" y1="54" x2="152" y2="118"/><line x1="52" y1="130" x2="92" y2="160"/><line x1="148" y1="130" x2="108" y2="160"/><line x1="100" y1="184" x2="92" y2="160"/><line x1="100" y1="184" x2="108" y2="160"/>
    </svg>
    <h2>Almost there.</h2>
    <p>Set your new password and get straight back to your health journey.</p>
    <div class="features">
      <div class="feature"><span class="dot"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span> Your password is encrypted end-to-end</div>
      <div class="feature"><span class="dot"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span> Reset links are one-time use</div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/js/auth.js" defer></script>
