<%
  const page = 'auth';
  const title = 'Reset your password — BIOSYM Pharma';
%>
<%- include('../partials/head', { page, title }) %>

<div class="auth-shell">
  <div class="auth-panel">
    <div class="auth-card">
      <div class="auth-head">
        <img class="auth-mark" src="/favicon.svg" alt="BIOSYM">
        <h1>Forgot password?</h1>
        <p>Enter your registered email or mobile number and we'll send you a verification code.</p>
      </div>

      <div id="error-slot"></div>

      <form data-forgot-form novalidate>
        <div class="field">
          <label class="label" for="f-id">Email or Mobile Number</label>
          <input class="input" id="f-id" name="identifier" type="text" placeholder="you@example.com or 98765 43210" autocomplete="username" required>
        </div>
        <div style="margin-bottom:16px">
          <label class="row" style="gap:8px;font-size:13.5px;color:var(--ink-600);cursor:pointer;margin-bottom:8px">
            <input type="radio" name="channel" value="sms" checked style="accent-color:var(--green-600)"> Send code by SMS
          </label>
          <label class="row" style="gap:8px;font-size:13.5px;color:var(--ink-600);cursor:pointer">
            <input type="radio" name="channel" value="email" style="accent-color:var(--green-600)"> Send code by email
          </label>
        </div>
        <button class="btn btn-primary btn-lg btn-block" type="submit" data-send-btn>
          <span>Send OTP</span>
        </button>
      </form>

      <div class="auth-alt" style="margin-top:18px"><a class="link" href="/login">← Back to sign in</a></div>
    </div>
  </div>

  <div class="auth-side">
    <svg class="molecule" viewBox="0 0 200 200" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1.6">
      <circle cx="100" cy="40" r="14"/><circle cx="40" cy="130" r="14"/><circle cx="160" cy="130" r="14"/><circle cx="100" cy="170" r="14"/>
      <line x1="100" y1="54" x2="48" y2="118"/><line x1="100" y1="54" x2="152" y2="118"/><line x1="52" y1="130" x2="92" y2="160"/><line x1="148" y1="130" x2="108" y2="160"/><line x1="100" y1="184" x2="92" y2="160"/><line x1="100" y1="184" x2="108" y2="160"/>
    </svg>
    <h2>We'll help you<br>get back in.</h2>
    <p>A secure one-time code will be sent to your registered email or mobile number.</p>
    <div class="features">
      <div class="feature"><span class="dot"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span> No data loss — only password changes</div>
      <div class="feature"><span class="dot"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span> Reset links expire in 10 minutes</div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/js/auth.js" defer></script>
