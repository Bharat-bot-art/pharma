<%
  const page = 'auth';
  const title = 'Create your BIOSYM account';
%>
<%- include('../partials/head', { page, title }) %>

<div class="auth-shell">
  <div class="auth-panel">
    <div class="auth-card">
      <div class="auth-head">
        <img class="auth-mark" src="/favicon.svg" alt="BIOSYM">
        <h1>Create your account</h1>
        <p>Join BIOSYM for faster checkout and order tracking</p>
      </div>

      <div id="error-slot"></div>

      <form data-register-form novalidate>
        <div class="field">
          <label class="label" for="r-name">Full Name</label>
          <input class="input" id="r-name" name="fullName" type="text" placeholder="As per your ID proof" autocomplete="name" required>
          <span class="error-text" data-err="fullName">Please enter your full name.</span>
        </div>
        <div class="form-grid-2">
          <div class="field">
            <label class="label" for="r-email">Email</label>
            <input class="input" id="r-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required>
            <span class="error-text" data-err="email">Please enter a valid email.</span>
          </div>
          <div class="field">
            <label class="label" for="r-mobile">Mobile Number</label>
            <div class="input-wrap">
              <span class="input-prefix">+91</span>
              <input class="input" id="r-mobile" name="mobile" type="tel" placeholder="98765 43210" inputmode="numeric" maxlength="10" autocomplete="tel" required>
            </div>
            <span class="error-text" data-err="mobile">Enter a valid 10-digit mobile number.</span>
          </div>
        </div>
        <div class="form-grid-2">
          <div class="field">
            <label class="label" for="r-dob">Date of Birth <span class="text-xs" style="font-weight:400;color:var(--ink-400)">(optional)</span></label>
            <input class="input" id="r-dob" name="dateOfBirth" type="date" max="<%= new Date().toISOString().split('T')[0] %>">
          </div>
          <div class="field">
            <label class="label" for="r-gender">Gender <span class="text-xs" style="font-weight:400;color:var(--ink-400)">(optional)</span></label>
            <select class="input" id="r-gender" name="gender">
              <option value="">Prefer not to say</option>
              <option>Male</option>
              <option>Female</option>
              <option>Other</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label class="label" for="r-pw">Password</label>
          <div class="input-wrap">
            <input class="input" id="r-pw" name="password" type="password" placeholder="Create a strong password" autocomplete="new-password" required data-caps-lock data-strength>
            <button type="button" class="toggle-pw" data-toggle-pw aria-label="Show password">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <div class="pw-meter" data-pw-meter><span></span><span></span><span></span><span></span></div>
          <div class="pw-label" data-pw-label>Too weak</div>
          <div class="caps-warning" data-caps-warning><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 20h20L12 3Z"/><path d="M12 9v5M12 17.5h.01"/></svg> Caps Lock is on</div>
        </div>
        <div class="field">
          <label class="label" for="r-cpw">Confirm Password</label>
          <div class="input-wrap">
            <input class="input" id="r-cpw" name="confirmPassword" type="password" placeholder="Re-enter your password" autocomplete="new-password" required>
            <button type="button" class="toggle-pw" data-toggle-pw aria-label="Show password">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <span class="error-text" data-err="confirmPassword">Passwords do not match.</span>
        </div>
        <div class="pw-rules" data-pw-rules>
          <span class="pw-rule" data-rule="length"><svg class="no" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"/></svg><span>8+ characters</span></span>
          <span class="pw-rule" data-rule="case"><svg class="no" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"/></svg><span>Upper &amp; lower case</span></span>
          <span class="pw-rule" data-rule="number"><svg class="no" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"/></svg><span>A number</span></span>
          <span class="pw-rule" data-rule="special"><svg class="no" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"/></svg><span>A special character</span></span>
        </div>
        <button class="btn btn-primary btn-lg btn-block" type="submit" data-register-btn style="margin-top:6px">
          <span>Create Account</span>
        </button>
      </form>

      <div class="auth-alt">Already have an account? <a class="link" href="/login?redirect=<%= encodeURIComponent(redirect) %>">Sign in</a></div>
    </div>
  </div>

  <div class="auth-side">
    <svg class="molecule" viewBox="0 0 200 200" fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="1.6">
      <circle cx="100" cy="40" r="14"/><circle cx="40" cy="130" r="14"/><circle cx="160" cy="130" r="14"/><circle cx="100" cy="170" r="14"/>
      <line x1="100" y1="54" x2="48" y2="118"/><line x1="100" y1="54" x2="152" y2="118"/><line x1="52" y1="130" x2="92" y2="160"/><line x1="148" y1="130" x2="108" y2="160"/><line x1="100" y1="184" x2="92" y2="160"/><line x1="100" y1="184" x2="108" y2="160"/>
    </svg>
    <h2>Your health journey<br>starts here.</h2>
    <p>Create an account to unlock faster checkout, order history and prescription reorders.</p>
    <div class="features">
      <div class="feature"><span class="dot"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span> One-tap reorders</div>
      <div class="feature"><span class="dot"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span> Track every order</div>
      <div class="feature"><span class="dot"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span> Your data stays private</div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/js/auth.js" defer></script>
