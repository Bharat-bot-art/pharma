<%
  const page = '';
%>
<%- include('../partials/head', { page, title }) %>
<div class="container" style="padding:80px 0;text-align:center">
  <div class="empty-state">
    <div class="art" style="width:150px;height:150px;background:var(--danger-bg);border-radius:50%;display:grid;place-items:center;color:var(--danger)"><svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 20h20L12 3Z"/><path d="M12 9v5M12 17.5h.01"/></svg></div>
    <h1 style="font-size:26px;margin-top:18px"><%= status %> — <%= code %></h1>
    <p class="text-muted"><%= message %></p>
    <div class="row" style="justify-content:center;margin-top:20px">
      <a class="btn btn-primary" href="/">Go Home</a>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
