# ============================================================
# BIOSYM Pharma — Environment Configuration
# Copy this file to `.env` and fill in your real credentials.
# NEVER commit `.env` to version control.
# ============================================================

# ---- Server ----
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ---- Session / JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- OTP Provider ----
# Allowed: msg91 | twilio | console
# `console` is for local development without external keys — it prints the OTP
# to the server console. Production MUST use msg91 or twilio.
OTP_PROVIDER=console

# ---- MSG91 ----
MSG91_API_KEY=
MSG91_SENDER_ID=BIOSYM
MSG91_TEMPLATE_ID=0
MSG91_COUNTRY_CODE=91
MSG91_OTP_EXPIRY=5

# ---- Twilio Verify ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- Resend (transactional email / email OTP) ----
RESEND_API_KEY=
EMAIL_FROM=BIOSYM Pharma <auth@yourdomain.com>
# Enable OTP via email as well as SMS
EMAIL_OTP_ENABLED=true

# ---- Payments ----
# Cash on Delivery works out of the box. Razorpay activates ONLY when keys are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Shiprocket (real shipment tracking) ----
# Configure to enable creating shipments + live courier tracking.
# Provide either a token, or email+password to obtain one automatically.
SHIPROCKET_TOKEN=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ---- WhatsApp support shortcut (wa.me link; digits only with country code) ----
WHATSAPP_NUMBER=916266530793
